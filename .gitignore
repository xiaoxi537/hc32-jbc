# ==========================================
# 1. 编译输出目录（整个忽略）
# ==========================================
build/

# ==========================================
# 2. 其他编译产物（防止散落在其他地方）
# ==========================================
*.o
*.d
*.lst
*.elf
*.bin
*.hex
*.map


# ==========================================
# 4. IDE 和编辑器
# ==========================================
.vscode/
.idea/
*.swp
*~

# ==========================================
# 5. 操作系统文件
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# 6. 例外放行：固件备份是宝贝
# ==========================================
!tools/fw/
!tools/fw/*.bin
!tools/fw/*.hex
!tools/*.jlink
!tools/*.py
!tools/*.sh
!tools/*.md
!tools/ui_*.txt
.rollback/

# 仿真临时产物
/tools/sim_pid_v930

# 基线数据：CSV 入库（对照基准，必须可追溯），但 PPM/临时文件不入库
docs/baseline/failed/*.csv
__pycache__/
