// 原机固件 C210 升温曲线采样（先确认 read_original_ctx 正常）
// 80 ℃ 降温 25 s，再 300 ℃；每 200 ms 采样 temp/PID/duty/current/VIN
// 注意：会真正加热；确认 C210 已插好、12 V 限流后再执行。
si SWD
speed 1000
device HC32F46X
connect
h
w2 0x20014A58, 0x0050
g
Sleep 25000
h
mem32 0x20014A6C 1
mem16 0x20014A54 1
w2 0x20014A58, 0x012C
g
Sleep 200
h
mem32 0x20014A6C 2
mem16 0x20014A56 1
mem8 0x20014A7B 1
mem32 0x20014A68 1
g
Sleep 200
