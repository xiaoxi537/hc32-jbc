# ==========================================
# 1. 编译输出目录（整个忽略）
# ==========================================
build/

# ==========================================
# 2. 其他编译产物（防止散落在其他地方）
# ==========================================
*.o
*.d
*.lst
*.elf
*.bin
*.hex
*.map

# ==========================================
# 3. IDE 和编辑器
# ==========================================
.vscode/
.idea/
*.swp
*~

# ==========================================
# 4. 操作系统文件
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# 5. 保留的例外
# ==========================================
# 工具脚本与字库字符集是工程的一部分，上面的 *.bin 等规则不应误伤
!tools/*.jlink
!tools/*.py
!tools/*.sh
!tools/*.md
!tools/ui_*.txt
.rollback/

# 仿真临时产物
/tools/sim_pid_v930

# ==========================================
# 6. 本地工作资料，不入库
# ==========================================
# docs/ 是开发过程记录（进度、迭代日志、实测基线 CSV、界面截图），
# 数量多且体积大（13M），不进入远程仓库。
# **本地文件保留**，只是不受 git 跟踪。
docs/

# 历史固件归档：本地保留用于回退对照，不推送到远程
tools/fw/

__pycache__/
